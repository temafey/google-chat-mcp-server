      "ru": {
        "header_title": "📥 Триаж чатов",
        "new_clause": "🆕 $count новых",
        "overdue_clause": "⏰ $count просрочено",
        "more_new": "…и ещё $count новых",
        "direct_message": "Личное сообщение",
        "unknown_sender": "(неизвестно)",
        "open_link": "🔗 Открыть в чате",
