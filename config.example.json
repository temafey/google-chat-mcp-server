        "more_new": "…and $count more new",
        "direct_message": "Direct message",
        "unknown_sender": "(unknown)",
        "open_link": "🔗 Open in Chat",
        "original_message": "Original message",
        "promise_label": "promise",
        "due_label": "due",
        "no_due": "(no due date)"
